# Copy this file to `.env` and fill in ONE key.
# The engine auto-detects the provider in this order:
# OpenRouter -> Gemini -> OpenAI -> local Ollama (no key needed)

# Option 1: OpenRouter (free models available - https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Option 2: Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Option 3: OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Option 4: no key at all - just run Ollama locally:
#   ollama pull llama3.1 && ollama serve
